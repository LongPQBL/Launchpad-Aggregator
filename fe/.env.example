# BE_API_URL is read server-side (Next.js server components / route fetches).
BE_API_URL=http://127.0.0.1:3001

# NEXT_PUBLIC_BE_API_URL is exposed to the browser for the SSE live-refresh connection
# (fe/src/hooks/use-live-refresh.ts). It should point at the same BE instance as BE_API_URL.
NEXT_PUBLIC_BE_API_URL=http://127.0.0.1:3001

# NEXT_PUBLIC_PAYMASTER_SERVICE_URL (fe/src/trading/paymasterConfig.ts) sponsors gas for batched
# trades via EIP-5792's paymasterService capability. Leave unset until a real, funded Alchemy Gas
# Manager (or ZeroDev) policy exists for Robinhood Chain (chain 4663) — see CLAUDE.md's 2026-10-08
# entry for the research trail. Setting this with no real policy behind it will make batched
# trades fail for any wallet that reports paymasterService support.
NEXT_PUBLIC_PAYMASTER_SERVICE_URL=
