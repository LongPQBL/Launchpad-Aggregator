DATABASE_URL=postgres://launchpad:launchpad_local@127.0.0.1:55432/launchpad
TEST_DATABASE_URL=postgres://launchpad:launchpad_local@127.0.0.1:55432/launchpad_test
RH_HTTP_RPC_URL=https://rpc.mainnet.chain.robinhood.com
FE_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
INDEXER_MAX_BLOCKS_PER_CYCLE=10000
# Set this to the provider's eth_getLogs block-range cap (Validation Cloud: 2000).
# INDEXER_SHARED_RPC_LOG_RANGE=2000
# INDEXER_SOURCE_IDS=pons-v2,pons-v2-curve
# Set to "jobs" to run the bounded parallel job-queue scheduler instead of the sequential
# runOnce() loop (docs/superpowers/specs/2026-09-30-parallel-indexer-design.md). Leave unset to
# keep the old sequential runner for rollback.
# INDEXER_SCHEDULER=jobs
# Each trade source can use its own dedicated RPC endpoint instead of the shared one — see
# README.md, 2026-09-30 (the free public RPC proved permanently unreliable for these sources).
# RH_RPC_URL_PONS_V1_LEGACY_TRADES=
# RH_RPC_URL_PONS_V1_ACTIVE_TRADES=
# RH_RPC_URL_PONS_V2_CURVE=
# INDEXER_ACTIVE_BLOCK_BATCH_CONCURRENCY=1
# In INDEXER_SCHEDULER=jobs mode, the AIMD ceiling (jobScheduler.ts) for the 'shared' endpoint
# (factory/lifecycle/every V4 pool). Measured 2026-09-30: the RPC tolerated 30 concurrent
# eth_blockNumber calls and 15 concurrent eth_getLogs calls (2,000-block range) with zero errors.
# Default 12 leaves headroom under that; AIMD backs off automatically on a real 429/503.
# INDEXER_SHARED_CONCURRENCY_CEILING=12
# Envio sync layer (Phase 1 — Pons V1-legacy only). Points at the self-hosted Envio Postgres from
# envio/docker-compose.yaml; table/schema names confirmed empirically in Task 1 Step 7.
# ENVIO_DATABASE_URL=
# ENVIO_RAW_LAUNCH_TABLE=envio."RawLaunch"
# ENVIO_RAW_SWAP_TABLE=envio."RawSwap"
# Envio sync layer — Phase 2 (Pons V2). Same ENVIO_DATABASE_URL as Phase 1.
# ENVIO_RAW_LAUNCH_V2_TABLE=envio."RawLaunchV2"
# ENVIO_RAW_CURVE_TRADE_TABLE=envio."RawCurveTrade"
# ENVIO_RAW_CURVE_BUYBACK_TABLE=envio."RawCurveBuyback"
# ENVIO_RAW_LIFECYCLE_TABLE=envio."RawLifecycleTransition"
# Envio sync layer — Phase 3 (Pons V2 -> V4). Same ENVIO_DATABASE_URL as Phase 1/2.
# ENVIO_RAW_V4_INITIALIZE_TABLE=envio."RawV4Initialize"
# ENVIO_RAW_V4_SWAP_TABLE=envio."RawV4Swap"
# Milliseconds between cycles for `sync:envio-staging:loop` (runs V1-legacy + V2 + V4 sync repeatedly
# instead of once, so staging keeps catching up while you compare manually with compare:envio-staging).
# ENVIO_SYNC_LOOP_INTERVAL_MS=900000
