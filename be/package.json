{
  "name": "be",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "dev:api": "tsx --env-file-if-exists=.env src/cli/api.ts",
    "sync:envio-staging": "tsx --env-file-if-exists=.env src/cli/syncEnvioStaging.ts",
    "sync:envio-staging:loop": "tsx --env-file-if-exists=.env src/cli/syncEnvioStagingLoop.ts",
    "compare:envio-staging": "tsx --env-file-if-exists=.env src/cli/compareEnvioStaging.ts",
    "openapi:write": "tsx src/cli/openapi.ts --write",
    "openapi:check": "tsx src/cli/openapi.ts --check",
    "seed:known-quote-feeds": "tsx --env-file-if-exists=.env src/cli/seedKnownQuoteFeeds.ts",
    "backfill:feed-resolution-jobs": "tsx --env-file-if-exists=.env src/cli/backfillFeedResolutionJobs.ts",
    "candles:backfill": "tsx --env-file-if-exists=.env src/cli/backfillCandles.ts",
    "candles:worker": "tsx --env-file-if-exists=.env src/cli/runCandleWorker.ts",
    "launch-volume:worker": "tsx --env-file-if-exists=.env src/cli/runLaunchVolumeWorker.ts",
    "launch-volume:backfill": "tsx --env-file-if-exists=.env src/cli/backfillLaunchVolumes.ts",
    "launch-volume:reconcile": "tsx --env-file-if-exists=.env src/cli/reconcileLaunchVolumes.ts",
    "usd-candles:worker": "tsx --env-file-if-exists=.env src/cli/runUsdCandleWorker.ts",
    "mode:test": "bash ../scripts/mode.sh test",
    "mode:prod": "bash ../scripts/mode.sh prod",
    "pools:candles:worker": "tsx --env-file-if-exists=.env src/cli/runPoolCandleWorker.ts",
    "pools:parity": "tsx --env-file-if-exists=.env src/cli/probePoolSources.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
